# Local development: embedded Postgres, no password, no SSL.
DATABASE_URL=pglite:./.data/dev
PORT=3000

# Production (set as Fly.io secrets, see the root README):
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres
# DATABASE_SSL=verify            # verify (default in production) | no-verify | off
# DATABASE_SSL_CA=<PEM text of Supabase's CA certificate>
# APP_PASSWORD=<at least 8 characters>
# SESSION_SECRET=<at least 32 characters: openssl rand -base64 48>
# NODE_ENV=production
# WEB_ROOT=../web/dist           # serve the built web app (set in the Docker image)

# Google service account key (paste the key file's JSON on one line),
# or set GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json instead.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Daily Sheet sync (cron syntax) and its timezone
SYNC_CRON=0 4 * * *
SYNC_TIMEZONE=Europe/Kyiv
